<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/galleryRoot"
    android:background="@color/colorBlack"
    android:clickable="true"
    android:focusable="true">

    <!-- Свайп вниз закрывает просмотр -->
    <kg.black13.kyrgyzstanwallpaper.SwipeDismissLayoutKt
        android:id="@+id/swipeDismiss"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </kg.black13.kyrgyzstanwallpaper.SwipeDismissLayoutKt>

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_circle_scrim"
        android:contentDescription="@string/back"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back" />

    <!-- Панель действий с картинкой -->
    <FrameLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim"
        android:paddingTop="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Автор и лицензия фото: для Wikimedia Commons это обязательное условие -->
        <TextView
            android:id="@+id/credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackground"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <Button
                android:id="@+id/btnFavorite"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/fab_options_favorite"
                app:icon="@drawable/ic_favorite_border"
                app:iconSize="24dp" />

            <Button
                android:id="@+id/btnSave"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/fab_options_save"
                app:icon="@drawable/ic_save"
                app:iconSize="24dp" />

            <Button
                android:id="@+id/btnEdit"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/card_with_name"
                android:visibility="gone"
                app:icon="@drawable/ic_edit"
                app:iconSize="24dp" />

            <Button
                android:id="@+id/btnShare"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/fab_options_share"
                app:icon="@drawable/ic_share"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSet"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/set_wallpaper"
                android:textSize="16sp"
                app:icon="@drawable/ic_wallpaper"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
