<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorBackground"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/colorOnSurface"
        app:title="@string/action_settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/SettingsSection"
                android:layout_marginTop="8dp"
                android:text="@string/settings_section_auto" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAuto"
                style="@style/SettingsTitle"
                android:text="@string/settings_auto_wallpaper" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/settings_auto_wallpaper_hint" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/autoSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/sourceFavorites"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:maxLines="2"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_auto_source_favorites" />

                <Button
                    android:id="@+id/sourceAll"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:maxLines="2"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_auto_source_all" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchWeekly"
                style="@style/SettingsTitle"
                android:layout_marginTop="20dp"
                android:text="@string/settings_weekly" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/settings_weekly_hint" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchReminder"
                style="@style/SettingsTitle"
                android:layout_marginTop="20dp"
                android:text="@string/settings_reminder" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/settings_reminder_hint" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchHolidays"
                style="@style/SettingsTitle"
                android:layout_marginTop="20dp"
                android:text="@string/settings_holidays" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/settings_holidays_hint" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_section_theme" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/themeMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/themeSystem"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:maxLines="2"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/theme_system" />

                <Button
                    android:id="@+id/themeLight"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:maxLines="2"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/theme_light" />

                <Button
                    android:id="@+id/themeDark"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:maxLines="2"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/theme_dark" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_section_language" />

            <Button
                android:id="@+id/btnLanguage"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_section_rate" />

            <Button
                android:id="@+id/btnRate"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_rate" />

            <TextView
                android:id="@+id/purchasesTitle"
                android:visibility="gone"
                style="@style/SettingsSection"
                android:text="@string/settings_section_purchases" />

            <Button
                android:id="@+id/btn2"
                android:visibility="gone"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btn3"
                android:visibility="gone"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
