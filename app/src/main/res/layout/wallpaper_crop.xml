<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBlack"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/cropToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorBlack"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/crop_title"
        app:titleTextColor="@color/colorWhite" />

    <!-- Рамка в пропорциях экрана телефона: в ней видно то, что станет обоями -->
    <FrameLayout
        android:id="@+id/cropArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <FrameLayout
            android:id="@+id/cropFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_crop_frame"
            android:clipToOutline="true">

            <com.ortiz.touchview.TouchImageView
                android:id="@+id/cropImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_crop_outline" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/cropProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:text="@string/crop_hint"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/cropCancel"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textColor="@color/colorWhite" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cropApply"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.4"
            android:text="@string/set_wallpaper"
            android:textSize="16sp"
            app:icon="@drawable/ic_wallpaper"
            app:iconGravity="textStart" />
    </LinearLayout>

</LinearLayout>
